# 只提交本项目自己的代码与文档；外部参考工程各自带 .git，不纳入
0x808/
FamiStudio/
Gridline/
/furnace/
grauw/
libmidi/
libvgm/
nanotracker/
tks/
studio/

# 构建产物
cli/build/
*/build/
build/

# 中间产物与临时文件
.work/
*.o
*.obj
*.a
*.exe

# 测试用的 VGM 是商业游戏的原声，不随仓库分发（见 vgm/README.md）
vgm/*
!vgm/README.md

# 所有生成物统一落在 out/，按 游戏/曲目 分类。
# 入库：音色文件 .fui / .fur（参数数据，不含乐曲本身）、说明文件
# 不入库：
#   · .json       单曲 3–8 MB，历史版本合计上百 MB
#   · .vgm        原版是商业游戏原声、成品是它的衍生，本仓库是 public，
#                 不能分发（与 vgm/ 同一限制，见 vgm/README.md）
out/**
!out/README.md
!out/**/
!out/**/*.fui
!out/**/*.fur
# 探针产物只是诊断中间件，不入库
out/**/probes/

# 系统
.DS_Store
Thumbs.db
