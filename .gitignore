# 外部参考工程统一收在 refs/（各自带 .git，不进本仓库）
refs/0x808/
refs/FamiStudio/
refs/Gridline/
refs/furnace/
refs/grauw/
refs/libmidi/
refs/libvgm/
refs/nanotracker/
refs/tks/
refs/studio/
refs/_archives/
!refs/README.md

# 构建产物
cli/build/
*/build/
build/

# 中间产物与临时文件
.work/
*.o
*.obj
*.a
*.exe

# 所有生成物统一落在 out/，按 游戏/曲目 分类。
# 入库：.vgm / .fui / .fur / 说明文件
# 不入库：.json（单曲 3–8 MB，历史版本合计上百 MB）
out/**
!out/README.md
!out/**/
!out/**/*.fui
!out/**/*.fur
!out/**/*.vgm
# 探针产物只是诊断中间件，不入库
out/**/probes/

# 系统
.DS_Store
Thumbs.db
